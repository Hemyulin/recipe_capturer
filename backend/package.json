{
  "name": "@cookbuk/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\"",
